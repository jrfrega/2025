y = -150*x - 10.5*x^2 +800 + 40*rnorm(x)
x = x %>% round(1)
y = y %>% round(1)
plot(x, y)
mhist(y)
mhist(y %>% log)
plot(x, y)
set.seed(10)
x = rnorm(250, 10, 1)
y = -150*x - 10.5*x^2 +4800 + 40*rnorm(x)
